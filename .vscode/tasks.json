{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-vite-dev",
            "type": "npm",
            "script": "dev",
            "path": "frontend/",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "beginsPattern": ".*VITE.*vite.*",
                    "endsPattern": ".*ready in.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "wails"
            }
        }
    ]
}